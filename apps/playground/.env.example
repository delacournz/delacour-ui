# Copy this file to .env and fill in your values
# Run: cp .env.example .env

# Expo API Token - If you use multiple accounts aka a personal and a work account, you can use this to switch between them.
# Expo only allows you to have one token per account. If using the global auth. 
EXPO_TOKEN=

# EAS Observe - set to 1 to dispatch metrics from a dev client, to prove the wiring end to end.
# Debug builds dispatch nothing without it, and it has no effect on a release build.
EXPO_PUBLIC_OBSERVE_IN_DEBUG=
