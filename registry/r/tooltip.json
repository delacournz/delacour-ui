{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "tooltip",
	"type": "registry:ui",
	"title": "Tooltip",
	"description": "A short label on a long press, anchored to its control: hides itself, lets an outside tap through, and reads to a screen reader on the trigger.",
	"categories": [
		"overlays"
	],
	"registryDependencies": [
		"overlay",
		"popover",
		"pressable",
		"slot",
		"text",
		"tv",
		"use-controllable-state"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [
		"react-native-reanimated",
		"react-native-worklets"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/react-native-ui/src/components/tooltip/AGENTS.md",
			"target": "tooltip/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "@delacour/react-native-ui/tooltip",
					"to": "@registry/ui/tooltip"
				}
			]
