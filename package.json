{
	"name": "@delacour/source",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.3.9",
	"scripts": {
		"postinstall": "git rev-parse --git-dir > /dev/null 2>&1 && prek install || true",
		"dev": "turbo dev",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"check": "turbo check",
		"lint": "turbo lint",
		"fmt": "turbo fmt",
		"test": "turbo test",
		"nuke": "rm -rf node_modules ./apps/**/node_modules ./packages/**/node_modules && bun install --no-cache -f"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@j178/prek": "^0.3.5",
		"@types/bun": "^1.3.8",
		"@types/node": "^22.15.0",
		"turbo": "^2.8.2",
		"typescript": "^5.9.3"
	},
	}
}
