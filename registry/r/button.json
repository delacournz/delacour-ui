{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "button",
	"type": "registry:ui",
	"title": "Button",
	"description": "A pressable action composed from parts, with variants, sizes and a loading state.",
	"categories": [
		"controls"
	],
	"registryDependencies": [
		"icon",
		"pressable",
		"spinner",
		"text",
		"tv"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/components/button/AGENTS.md",
			"target": "button/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "@delacour/native-ui/button",
					"to": "@registry/ui/button"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/button/button-end-content.tsx",
			"target": "button/button-end-content.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/button/button-label.tsx",
			"target": "button/button-label.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/button/button-start-content.tsx",
			"target": "button/button-start-content.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/button/button.context.tsx",
			"target": "button/button.context.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/button/button.tsx",
			"target": "button/button.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				},
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				},
				{
					"from": "../spinner",
					"to": "@registry/ui/spinner"
				},
				{
					"from": "../text/text.context",
					"to": "@registry/ui/text/text.context"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/button/button.types.ts",
			"target": "button/button.types.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/button/button.variants.ts",
			"target": "button/button.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/button/index.ts",
			"target": "button/index.ts",
			"namespace": "ui"
		}
	]
}
