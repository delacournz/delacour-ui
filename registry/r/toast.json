{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "toast",
	"type": "registry:ui",
	"title": "Toast",
	"description": "A brief message shown from anywhere, even outside React: stacked at an edge, swiped away, paused while touched, with a promise form and Alert's statuses.",
	"categories": [
		"overlays"
	],
	"registryDependencies": [
		"alert",
		"icon",
		"icons",
		"overlay",
		"pressable",
		"spinner",
		"text",
		"tv"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [
		"react-native-gesture-handler",
		"react-native-keyboard-controller",
		"react-native-reanimated",
		"react-native-safe-area-context",
		"react-native-teleport",
		"react-native-worklets"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/react-native-ui/src/components/toast/AGENTS.md",
			"target": "toast/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "@delacour/react-native-ui/toast",
					"to": "@registry/ui/toast"
				}
			]
		},
