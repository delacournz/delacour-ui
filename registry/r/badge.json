{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "badge",
	"type": "registry:ui",
	"title": "Badge",
	"description": "A compact label for status or a count, composed from parts like the button.",
	"categories": [
		"display"
	],
	"registryDependencies": [
		"icon",
		"icons",
		"pressable",
		"text",
		"tv"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/components/badge/AGENTS.md",
			"target": "badge/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "delacour-react-native-ui/badge",
					"to": "@registry/ui/badge"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/badge/badge-close-button.tsx",
			"target": "badge/badge-close-button.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../icons/central",
					"to": "@registry/icons/central"
				},
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				},
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/badge/badge-end-content.tsx",
			"target": "badge/badge-end-content.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/badge/badge-label.tsx",
			"target": "badge/badge-label.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/badge/badge-start-content.tsx",
			"target": "badge/badge-start-content.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/badge/badge.context.tsx",
			"target": "badge/badge.context.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/badge/badge.tsx",
			"target": "badge/badge.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				},
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				},
				{
					"from": "../text/text.context",
					"to": "@registry/ui/text/text.context"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/badge/badge.types.ts",
			"target": "badge/badge.types.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/badge/badge.variants.ts",
			"target": "badge/badge.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/badge/index.ts",
			"target": "badge/index.ts",
			"namespace": "ui"
		}
	]
}
