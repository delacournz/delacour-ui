{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"version": {
			"type": "number",
			"const": 1
		},
		"items": {
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"files": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"type": "object",
							"properties": {
								"ref": {
									"type": "string",
									"minLength": 1
								},
								"hash": {
									"type": "string",
									"pattern": "^sha256-[0-9a-f]{64}$"
								}
							},
							"required": [
								"ref",
								"hash"
							]
						}
					}
				},
				"required": [
					"files"
				]
			}
		}
	},
	"required": [
		"version",
		"items"
	]
}
