{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "cn",
	"type": "registry:lib",
	"title": "cn",
	"description": "Class merging that understands the library's semantic size tokens.",
	"registryDependencies": [
		"styles"
	],
	"dependencies": [
		"clsx",
		"tailwind-merge"
	],
	"expoDependencies": [],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/lib/cn.ts",
			"target": "cn.ts",
			"namespace": "lib",
			"rewrites": [
				{
					"from": "../styles/tokens",
					"to": "@registry/styles/tokens"
				}
			]
		}
	]
}
