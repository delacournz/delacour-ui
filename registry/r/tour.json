{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "tour",
	"type": "registry:ui",
	"title": "Tour",
	"description": "A guided walkthrough: the screen dims, a hole is cut around one control and a card beside it explains it, with Next, Back and Skip.",
	"categories": [
		"navigation"
	],
	"registryDependencies": [
		"button",
		"pressable",
		"text",
		"tv",
		"use-controllable-state",
		"use-theme-color"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [
		"react-native-gesture-handler",
		"react-native-reanimated",
		"react-native-safe-area-context",
		"react-native-skia"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/react-native-ui/src/components/tour/AGENTS.md",
			"target": "tour/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "@delacour/react-native-ui/tour",
					"to": "@registry/ui/tour"
				}
			]
