{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "separator",
	"type": "registry:ui",
	"title": "Separator",
	"description": "A one-pixel rule, hidden from assistive technology.",
	"categories": [
		"layout"
	],
	"registryDependencies": [
		"tv"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/components/separator/AGENTS.md",
			"target": "separator/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "delacour-react-native-ui/separator",
					"to": "@registry/ui/separator"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/separator/index.ts",
			"target": "separator/index.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/separator/separator.tsx",
			"target": "separator/separator.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				}
			]
		}
	]
}
