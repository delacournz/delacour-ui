.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# turbo
.turbo

# expo / react native
# Native projects are generated by `expo prebuild` (Continuous Native
# Generation); anchored per-app so a bare "ios"/"android" cannot match an
# unrelated source directory deeper in the tree.
.expo
expo-env.d.ts
/apps/*/ios
/apps/*/android
*.orig.*

# TanStack Start / Vite / Nitro build artefacts and fumadocs-mdx generated content.
.output
.nitro
.tanstack
.vite
.source

# argent — `flags.json` and `flows/previews/**` are committed; everything else
# under .argent is per-run scratch. `recordings/` is the important one: raw
# device-native h264 at 1206x2622, tens of MB per capture run.
/.argent/recordings
/.argent/reports
/.argent/artifacts
/.argent/tmp
/.argent/flows/__baselines__
/.argent/*.log
