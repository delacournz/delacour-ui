{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "progress-button",
	"type": "registry:ui",
	"title": "Progress Button",
	"description": "A button held to confirm: a fill grows while it is held and the action fires when it reaches the end.",
	"categories": [
		"controls"
	],
	"registryDependencies": [
		"cn",
		"icon",
		"icons",
		"pressable",
		"text",
		"tv",
		"use-controllable-state"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [
		"react-native-gesture-handler",
		"react-native-reanimated",
		"react-native-worklets"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/react-native-ui/src/components/progress-button/AGENTS.md",
			"target": "progress-button/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "@delacour/react-native-ui/progress-button",
					"to": "@registry/ui/progress-button"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/progress-button/index.ts",
			"target": "progress-button/index.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/react-native-ui/src/components/progress-button/progress-button-done.tsx",
			"target": "progress-button/progress-button-done.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../icons/central",
					"to": "@registry/icons/central"
				},
				{
					"from": "../../lib/cn",
					"to": "@registry/lib/cn"
				},
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/progress-button/progress-button-label.tsx",
			"target": "progress-button/progress-button-label.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/progress-button/progress-button.context.tsx",
			"target": "progress-button/progress-button.context.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/react-native-ui/src/components/progress-button/progress-button.tsx",
			"target": "progress-button/progress-button.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-controllable-state",
					"to": "@registry/hooks/use-controllable-state"
				},
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				},
				{
					"from": "../pressable/pressable",
					"to": "@registry/ui/pressable/pressable"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/progress-button/progress-button.variants.ts",
			"target": "progress-button/progress-button.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				}
			]
		}
	]
