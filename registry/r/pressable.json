{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "pressable",
	"type": "registry:ui",
	"title": "Pressable",
	"description": "The Gesture API press primitive: scale and fade feedback, haptics, disabled and busy states.",
	"categories": [
		"primitives"
	],
	"registryDependencies": [
		"compose-refs",
		"merge-props"
	],
	"dependencies": [],
	"expoDependencies": [
		"react-native-gesture-handler",
		"react-native-pulsar",
		"react-native-reanimated",
		"react-native-worklets"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/components/pressable/AGENTS.md",
			"target": "pressable/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "delacour-react-native-ui/pressable",
					"to": "@registry/ui/pressable"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/pressable/index.ts",
			"target": "pressable/index.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/pressable/pressable.tsx",
			"target": "pressable/pressable.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/compose-refs",
					"to": "@registry/lib/compose-refs"
				},
				{
					"from": "../../lib/merge-props",
					"to": "@registry/lib/merge-props"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/pressable/pressable.variants.ts",
			"target": "pressable/pressable.variants.ts",
			"namespace": "ui"
		}
	]
}
