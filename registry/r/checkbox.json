{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "checkbox",
	"type": "registry:ui",
	"title": "Checkbox",
	"description": "A checkbox with an indeterminate state, and a group that owns the selection.",
	"categories": [
		"forms"
	],
	"registryDependencies": [
		"field",
		"icon",
		"icons",
		"pressable",
		"text",
		"tv",
		"use-controllable-state",
		"use-theme-color"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [
		"react-native-reanimated",
		"uniwind"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/components/checkbox/AGENTS.md",
			"target": "checkbox/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "delacour-react-native-ui/checkbox",
					"to": "@registry/ui/checkbox"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/checkbox/checkbox-box.tsx",
			"target": "checkbox/checkbox-box.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-theme-color",
					"to": "@registry/hooks/use-theme-color"
				},
				{
					"from": "../../icons/central",
					"to": "@registry/icons/central"
				},
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/checkbox/checkbox-group.tsx",
			"target": "checkbox/checkbox-group.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-controllable-state",
					"to": "@registry/hooks/use-controllable-state"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/checkbox/checkbox-label.tsx",
			"target": "checkbox/checkbox-label.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/checkbox/checkbox.context.tsx",
			"target": "checkbox/checkbox.context.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/checkbox/checkbox.tsx",
			"target": "checkbox/checkbox.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-controllable-state",
					"to": "@registry/hooks/use-controllable-state"
				},
				{
					"from": "../field/field.context",
					"to": "@registry/ui/field/field.context"
				},
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/checkbox/checkbox.types.ts",
			"target": "checkbox/checkbox.types.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/checkbox/checkbox.variants.ts",
			"target": "checkbox/checkbox.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				},
				{
					"from": "../text/text.variants",
					"to": "@registry/ui/text/text.variants"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/checkbox/index.ts",
			"target": "checkbox/index.ts",
			"namespace": "ui"
		}
	]
}
