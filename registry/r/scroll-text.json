			"target": "scroll-text/scroll-text-source.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../screen/screen.context",
					"to": "@registry/ui/screen/screen.context"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/scroll-text/scroll-text-unit.tsx",
			"target": "scroll-text/scroll-text-unit.tsx",
			"namespace": "ui",
