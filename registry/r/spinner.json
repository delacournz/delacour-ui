{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "spinner",
	"type": "registry:ui",
	"title": "Spinner",
	"description": "An animated loading indicator drawn on the icon scale.",
	"categories": [
		"feedback"
	],
	"registryDependencies": [
		"cn",
		"icon",
		"tv",
		"use-theme-color"
	],
	"dependencies": [],
	"expoDependencies": [
		"react-native-reanimated",
		"react-native-svg"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/components/spinner/AGENTS.md",
			"target": "spinner/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "delacour-react-native-ui/spinner",
					"to": "@registry/ui/spinner"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/spinner/index.ts",
			"target": "spinner/index.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/spinner/spinner-arc.tsx",
			"target": "spinner/spinner-arc.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/spinner/spinner-content.tsx",
			"target": "spinner/spinner-content.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/spinner/spinner.context.tsx",
			"target": "spinner/spinner.context.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/spinner/spinner.tsx",
			"target": "spinner/spinner.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-theme-color",
					"to": "@registry/hooks/use-theme-color"
				},
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/spinner/spinner.variants.ts",
			"target": "spinner/spinner.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/cn",
					"to": "@registry/lib/cn"
				},
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				},
				{
					"from": "../icon/icon.variants",
					"to": "@registry/ui/icon/icon.variants"
				}
			]
		}
	]
}
