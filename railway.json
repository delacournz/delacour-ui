{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "NIXPACKS",
		"buildCommand": "bun install --frozen-lockfile && bun run build --filter=@delacour/web"
	},
	"deploy": {
		"startCommand": "bun apps/web/.output/server/index.mjs",
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 3
	}
}
