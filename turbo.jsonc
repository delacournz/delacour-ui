{
	"$schema": "https://turbo.build/schema.json",
	"concurrency": "30",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["dist/**", ".output/**"]
		},
		"dev": { "persistent": true },
		"typecheck": { "cache": false, "outputs": [] },
		"lint": { "cache": false, "outputs": [] },
		"fmt": { "cache": false, "outputs": [] },
		"check": { "cache": false, "outputs": [] },
		"test": { "cache": false, "outputs": [] },
		// Drives a simulator and writes into apps/web; never cached, never parallel.
		"previews": { "cache": false, "outputs": [], "persistent": false }
	}
}
