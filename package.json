{
	"name": "@delacour/source",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.3.14",
	"scripts": {
		"postinstall": "git rev-parse --git-dir > /dev/null 2>&1 && prek install || true",
		"dev": "turbo dev --ui tui",
		"dev:web": "turbo dev --filter=@delacour/web",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"check": "turbo check",
		"lint": "turbo lint",
		"fmt": "turbo fmt",
		"test": "turbo test test:release test:scripts",
		"test:release": "bun test ./.github/*.test.ts",
		"test:scripts": "bun test ./scripts/*.test.ts",
		"signoff": "bun scripts/signoff.ts",
		"changeset": "changeset",
		"version-packages": "bun .github/changeset-version.ts",
		"release": "bun .github/changeset-stage.ts",
		"verify:expo": "cd packages/cli && bun scripts/verify-expo.ts",
		"cli:link": "cd packages/cli && bun run build && bun scripts/link.ts link",
		"cli:unlink": "cd packages/cli && bun scripts/link.ts unlink",
		"nuke": "rm -rf node_modules ./apps/**/node_modules ./packages/**/node_modules && bun install --no-cache -f",
		"previews": "turbo previews --filter=@delacour/playground",
		"previews:verify": "turbo previews:verify --filter=@delacour/playground"
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@legendapp/list": "^3.6.0",
			"@types/react": "~19.3.0",
			"react": "19.3.0",
			"react-dom": "19.3.0",
			"react-native": "0.88.0",
			"react-native-gesture-handler": "~3.3.0",
			"react-native-keyboard-controller": "1.22.7",
			"react-native-reanimated": "4.7.1",
			"react-native-safe-area-context": "~5.10.1",
			"react-native-screens": "~4.30.0",
			"react-native-skia": "3.7.3",
			"react-native-svg": "15.16.0",
			"react-native-worklets": "0.13.0"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@delacour/tsconfig": "workspace:*",
		"@j178/prek": "^0.5.6",
		"@types/bun": "^1.4.3",
		"@types/node": "^22.20.5",
		"turbo": "^2.11.9",
		"typescript": "~6.0.3"
	},
	"overrides": {
		"@babel/core": "^7.29.7",
		"@delacournz/otel": "0.1.0"
	}
}
