{
	"$schema": "https://turbo.build/schema.json",
	"concurrency": "30",
	// Files outside every package that every lint, typecheck and test reads. A change to one is a
	// change to every task's hash.
	"globalDependencies": ["biome.jsonc", "bunfig.toml"],
	"tasks": {
		// A transit node: no package has a `transit` script, so it runs nothing. `dependsOn: ["transit"]`
		// folds every upstream workspace's file hash into a task's own, which is how a cached
		// `typecheck` or `test` misses when a package it imports changes. Turbo's documented pattern
		// for tasks that read their dependencies' source rather than their build output.
		"transit": { "dependsOn": ["^transit"] },

		"build": {
			"dependsOn": ["^build"],
			// Turbo 2 runs tasks in strict env mode: a variable not listed here is
			// stripped before the task starts. `apps/web` reads its analytics ids as
			// `VITE_*` at build time, so without this Railway's `turbo build` inlined
			// `undefined` and production shipped no Umami or GA tag at all.
			"env": ["VITE_*"],
			"cache": false,
			"outputs": ["dist/**", ".output/**"]
		},
		"dev": { "persistent": true },

		// Cached. A hit replays the logs of a run over byte-identical inputs, and `bun run signoff`
		// labels it `(cached)` in its report. A task that reads a file outside its own package and
		// outside its declared workspace dependencies must name that file in `inputs` below — the
		// `pkg#task` keys — or a change to it replays a stale green. AGENTS.md § Commands has the rule.
		"typecheck": { "dependsOn": ["transit"], "outputs": [] },
		"check": { "dependsOn": ["transit"], "outputs": [] },
		"test": { "dependsOn": ["transit"], "outputs": [] },

		// `apps/web` cannot typecheck until its route tree exists, and that file is
		// generated by the TanStack Start Vite plugin and gitignored. Without this
		// edge a clean checkout fails on every route — which is exactly what CI hit.
		// `codegen` is a whole `vite build`; caching it is most of what caching saves.
		"@delacour/web#codegen": {
			"dependsOn": ["transit"],
			// `release-notes` runs first and reads every published package's changelog and the pending changesets.
			"inputs": [
				"$TURBO_DEFAULT$",
				"!src/routeTree.gen.ts",
				"$TURBO_ROOT$/packages/*/CHANGELOG.md",
				"$TURBO_ROOT$/packages/*/package.json",
				"$TURBO_ROOT$/.changeset/**"
			],
			// The route tree alone: it is all `typecheck` needs, and restoring `.output/` from cache
			// raced `build`'s own `vite build` into the same directory when signoff ran both at once.
			"outputs": ["src/routeTree.gen.ts"],
			"env": ["VITE_*"]
		},
		"@delacour/web#typecheck": {
			"dependsOn": ["@delacour/web#codegen", "transit"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/apps/playground/src/**",
				"$TURBO_ROOT$/apps/playground/package.json",
				"$TURBO_ROOT$/packages/cli/src/**",
				"$TURBO_ROOT$/registry/**"
			],
			"outputs": []
		},
		"@delacour/web#test": {
			"dependsOn": ["transit"],
			"inputs": [
				"$TURBO_DEFAULT$",
				// What its tests read of the playground: source, manifest, app config. Not `apps/playground/**`
				// — an explicit glob ignores .gitignore, so that took in `.turbo/` logs and missed every run.
				"$TURBO_ROOT$/apps/playground/*",
				"$TURBO_ROOT$/apps/playground/src/**",
				"$TURBO_ROOT$/apps/playground/scripts/**",
				"$TURBO_ROOT$/apps/playground/e2e/**",
				"$TURBO_ROOT$/apps/playground/.eas/**",
				"$TURBO_ROOT$/packages/cli/src/**",
				"$TURBO_ROOT$/registry/**",
				"$TURBO_ROOT$/bun.lock",
				"$TURBO_ROOT$/packages/*/CHANGELOG.md",
				"$TURBO_ROOT$/packages/*/package.json",
				"$TURBO_ROOT$/.changeset/**"
			],
			"outputs": []
		},
		"@delacour/playground#typecheck": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/**", "$TURBO_ROOT$/apps/web/vite.config.ts"],
			"outputs": []
		},
		"@delacour/playground#test": {
			"dependsOn": ["transit"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/apps/web/src/**",
				"$TURBO_ROOT$/apps/web/vite.config.ts",
				"$TURBO_ROOT$/apps/web/public/previews/**"
			],
			"outputs": []
		},
		"delacour#typecheck": {
			"dependsOn": ["transit"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/packages/react-native-ui/**",
				"$TURBO_ROOT$/packages/react-native-charts/**",
				"$TURBO_ROOT$/packages/react-native-bottom-sheet/**",
				"$TURBO_ROOT$/registry/**"
			],
			"outputs": []
		},
		"delacour#test": {
			"dependsOn": ["transit"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/packages/react-native-ui/**",
				"$TURBO_ROOT$/packages/react-native-charts/**",
				"$TURBO_ROOT$/packages/react-native-bottom-sheet/**",
				"$TURBO_ROOT$/registry/**",
				"$TURBO_ROOT$/apps/web/content/**",
				"$TURBO_ROOT$/apps/web/src/**",
				"$TURBO_ROOT$/.agents/skills/**",
				"$TURBO_ROOT$/README.md"
			],
			"outputs": []
		},
		"@delacour/skills#test": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/registry/**"],
			"outputs": []
		},
		"@delacour/design-system#typecheck": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/react-native-ui/src/**"],
			"outputs": []
		},
		"@delacour/design-system#test": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/react-native-ui/src/**"],
			"outputs": []
		},

		"codegen": { "cache": false, "outputs": [] },
		"lint": { "cache": false, "outputs": [] },
		"fmt": { "cache": false, "outputs": [] },
		// Render tests (`*.render.test.tsx`): Jest through jest-expo, which `bun test` cannot run.
		"test:render": { "cache": false, "outputs": [] },
		// The release scripts under `.github/` belong to no workspace; this runs their tests. Root
		// tasks stay uncached: the root package's inputs are the whole repository.
		"//#test:release": { "cache": false, "outputs": [] },
		// `scripts/*.test.ts` (the signoff wrapper) belong to no workspace either.
		"//#test:scripts": { "cache": false, "outputs": [] },
		// The registry and the two modules derived from it, regenerated in order so `bun run signoff`'s
		// drift check runs them as one turbo invocation. Each later one reads `registry/`.
		"registry:build": { "cache": false, "outputs": [] },
		"gen-install": { "dependsOn": ["delacour#registry:build"], "cache": false, "outputs": [] },
		"gen-skill": { "dependsOn": ["delacour#registry:build"], "cache": false, "outputs": [] },
		"verify:expo": { "cache": false, "outputs": [] },
		// Drives a simulator and writes into apps/web; never cached, never parallel.
		"previews": { "cache": false, "outputs": [], "persistent": false },
		"previews:verify": { "cache": false, "outputs": [], "persistent": false }
	}
}
