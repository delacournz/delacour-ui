{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"extends": "//",
	"root": false,
	"files": {
		// Both are generated. `registry.ts` is written by `bun run gen-demos`, and
		// letting the formatter reflow it means the file on disk stops matching what
		// the generator produces — which `demos.test.ts` reads as a stale registry.
		"includes": ["src/**/*", "!src/uniwind-types.d.ts", "!src/demos/registry.ts"]
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"overrides": [
		{
			// Expo Router derives route names from filenames; its conventions
			// (_layout, [id], +not-found) are not kebab-case.
			"includes": ["src/app/**/*"],
			"linter": {
				"rules": {
					"style": { "useFilenamingConvention": "off" }
				}
			}
		},
		{
			// The library's component is called `Map`, and a demo imports it by that
			// name because a reader writes it by that name. It shadows the global
			// only inside these files, none of which wants the global.
			"includes": ["src/demos/map/**/*", "src/app/(components)/map.tsx"],
			"linter": {
				"rules": {
					"suspicious": { "noShadowRestrictedNames": "off" }
				}
			}
		}
	]
}
