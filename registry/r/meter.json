{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "meter",
	"type": "registry:ui",
	"title": "Meter",
	"description": "A measurement on a fixed scale, coloured by where it falls — by regions, thresholds or whole blocks.",
