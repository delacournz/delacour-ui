{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "slot",
	"type": "registry:lib",
	"title": "Slot",
	"description": "Renders into a child element instead of a wrapper.",
	"registryDependencies": [
		"compose-refs",
		"merge-props"
	],
	"dependencies": [],
	"expoDependencies": [],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/react-native-ui/src/lib/slot.tsx",
			"target": "slot.tsx",
			"namespace": "lib"
		}
	],
	"renderTests": [
		{
			"path": "packages/react-native-ui/src/lib/slot.render.test.tsx",
			"target": "slot.render.test.tsx",
			"namespace": "lib",
			"rewrites": [
				{
					"from": "../test/render",
					"to": "@registry/lib/test/render"
				}
			]
		}
	],
	"renderTestRegistryDependencies": [
		"test-kit"
	],
	"renderTestDependencies": [
		"@jest/globals"
	]
}
