{
	"$schema": "https://turbo.build/schema.json",
	"concurrency": "30",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["dist/**", ".output/**"]
		},
		"dev": { "persistent": true },
		"typecheck": { "cache": false, "outputs": [] },
		// `apps/web` cannot typecheck until its route tree exists, and that file is
		// generated by the TanStack Start Vite plugin and gitignored. Without this
		// edge a clean checkout fails on every route — which is exactly what CI hit.
		"@delacour/web#typecheck": { "dependsOn": ["@delacour/web#codegen"], "cache": false, "outputs": [] },
		"codegen": { "cache": false, "outputs": [] },
		"lint": { "cache": false, "outputs": [] },
		"fmt": { "cache": false, "outputs": [] },
		"check": { "cache": false, "outputs": [] },
		"test": { "cache": false, "outputs": [] },
		// Drives a simulator and writes into apps/web; never cached, never parallel.
		"previews": { "cache": false, "outputs": [], "persistent": false }
	}
}
