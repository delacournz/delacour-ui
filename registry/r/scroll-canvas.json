			"path": "packages/react-native-ui/src/components/scroll-canvas/scroll-canvas.tsx",
			"target": "scroll-canvas/scroll-canvas.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-calm-motion",
					"to": "@registry/hooks/use-calm-motion"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/scroll-canvas/scroll-canvas.types.ts",
			"target": "scroll-canvas/scroll-canvas.types.ts",
