{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "radio",
	"type": "registry:ui",
	"title": "Radio",
	"description": "A radio and the group that owns which one is selected.",
	"categories": [
		"forms"
	],
	"registryDependencies": [
		"field",
		"pressable",
		"text",
		"tv",
		"use-controllable-state"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [
		"react-native-reanimated"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/components/radio/AGENTS.md",
			"target": "radio/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "delacour-react-native-ui/radio",
					"to": "@registry/ui/radio"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/radio/index.ts",
			"target": "radio/index.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/radio/radio-group.tsx",
			"target": "radio/radio-group.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-controllable-state",
					"to": "@registry/hooks/use-controllable-state"
				},
				{
					"from": "../field/field.context",
					"to": "@registry/ui/field/field.context"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/radio/radio-indicator.tsx",
			"target": "radio/radio-indicator.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/radio/radio-label.tsx",
			"target": "radio/radio-label.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/radio/radio.context.tsx",
			"target": "radio/radio.context.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/radio/radio.tsx",
			"target": "radio/radio.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../field/field.context",
					"to": "@registry/ui/field/field.context"
				},
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				},
				{
					"from": "../text/text.context",
					"to": "@registry/ui/text/text.context"
				},
				{
					"from": "../text/text.variants",
					"to": "@registry/ui/text/text.variants"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/radio/radio.variants.ts",
			"target": "radio/radio.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				},
				{
					"from": "../text/text.variants",
					"to": "@registry/ui/text/text.variants"
				}
			]
		}
	]
}
