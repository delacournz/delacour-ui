{
	"name": "@delacour/react-native-bottom-sheet",
	"version": "0.1.0",
	"description": "Headless bottom sheet engine for React Native — no tokens, no className",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/delacournz/delacour-ui.git",
		"directory": "packages/react-native-bottom-sheet"
	},
	"keywords": [
		"react-native",
		"bottom-sheet",
		"reanimated",
		"gesture-handler",
		"keyboard-controller",
		"expo"
	],
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"README.md"
	],
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./core": "./src/core/index.ts"
	},
	"scripts": {
		"fmt": "biome format --write ./src",
		"lint": "biome lint --write ./src",
		"check": "biome check ./src",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-native": ">=0.81",
		"react-native-gesture-handler": ">=2.28",
		"react-native-keyboard-controller": ">=1.18",
		"react-native-reanimated": ">=4",
		"react-native-safe-area-context": ">=5",
		"react-native-teleport": ">=1.2",
		"react-native-worklets": ">=0.5"
	},
	"devDependencies": {
		"@delacour/biome-config": "workspace:*",
		"@delacour/tsconfig": "workspace:*",
		"@types/bun": "^1.3.8",
		"@types/react": "catalog:",
		"react-native-teleport": "^1.2.2",
		"typescript": "^5.9.3"
	}
}
