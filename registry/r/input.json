{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "input",
	"type": "registry:ui",
	"title": "Input",
	"description": "A text field, with a group that puts prefixes, suffixes, buttons and full-width blocks inside its border.",
	"categories": [
		"forms"
	],
	"registryDependencies": [
		"button",
		"cn",
		"compose-refs",
		"field",
		"icon",
		"pressable",
		"text",
		"tv"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/react-native-ui/src/components/input/AGENTS.md",
			"target": "input/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "@delacour/react-native-ui/input",
					"to": "@registry/ui/input"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/input/index.ts",
			"target": "input/index.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/react-native-ui/src/components/input/input-group-block.tsx",
			"target": "input/input-group-block.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				},
				{
					"from": "../text/text.context",
					"to": "@registry/ui/text/text.context"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/input/input-group-button.tsx",
			"target": "input/input-group-button.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../button",
					"to": "@registry/ui/button"
				},
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/input/input-group-decorator.tsx",
