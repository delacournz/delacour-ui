{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "tabs",
	"type": "registry:ui",
	"title": "Tabs",
	"description": "A swipeable pager with an indicator measured against the active tab.",
	"categories": [
		"navigation"
	],
	"registryDependencies": [
		"cn",
		"icon",
		"pressable",
		"separator",
		"text",
		"tv",
		"use-controllable-state",
		"use-theme-color"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [
		"react-native-gesture-handler",
		"react-native-reanimated",
		"react-native-worklets"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/components/tabs/AGENTS.md",
			"target": "tabs/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "delacour-react-native-ui/tabs",
					"to": "@registry/ui/tabs"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/tabs/index.ts",
			"target": "tabs/index.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/tabs/tabs-content.tsx",
			"target": "tabs/tabs-content.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/tabs/tabs-indicator.tsx",
			"target": "tabs/tabs-indicator.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/tabs/tabs-label.tsx",
			"target": "tabs/tabs-label.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-theme-color",
					"to": "@registry/hooks/use-theme-color"
				},
				{
					"from": "../text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/tabs/tabs-list.tsx",
			"target": "tabs/tabs-list.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/cn",
					"to": "@registry/lib/cn"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/tabs/tabs-pager.tsx",
			"target": "tabs/tabs-pager.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/tabs/tabs-scroll-view.tsx",
			"target": "tabs/tabs-scroll-view.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/tabs/tabs-separator.tsx",
			"target": "tabs/tabs-separator.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../separator",
					"to": "@registry/ui/separator"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/tabs/tabs-trigger.tsx",
			"target": "tabs/tabs-trigger.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				},
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				},
				{
					"from": "../text/text.context",
					"to": "@registry/ui/text/text.context"
				},
				{
					"from": "../text/text.variants",
					"to": "@registry/ui/text/text.variants"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/tabs/tabs.context.tsx",
			"target": "tabs/tabs.context.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/tabs/tabs.tsx",
			"target": "tabs/tabs.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-controllable-state",
					"to": "@registry/hooks/use-controllable-state"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/tabs/tabs.types.ts",
			"target": "tabs/tabs.types.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/tabs/tabs.variants.ts",
			"target": "tabs/tabs.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				},
				{
					"from": "../text/text.variants",
					"to": "@registry/ui/text/text.variants"
				}
			]
		}
	]
}
