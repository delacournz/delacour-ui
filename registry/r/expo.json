{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "expo",
	"type": "registry:lib",
	"title": "Navigation theme",
	"description": "Hands expo-router's navigator this library's colours, including the slab behind a push.",
	"registryDependencies": [
		"use-navigation-theme"
	],
	"dependencies": [],
	"expoDependencies": [
		"expo-router"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/expo/navigation-theme.tsx",
			"target": "expo/navigation-theme.tsx",
			"namespace": "lib",
			"rewrites": [
				{
					"from": "../hooks/use-navigation-theme",
					"to": "@registry/hooks/use-navigation-theme"
				},
				{
					"from": "delacour-react-native-ui/expo/navigation-theme",
					"to": "@registry/lib/expo/navigation-theme"
				},
				{
					"from": "delacour-react-native-ui/provider",
					"to": "@registry/ui/provider"
				}
			]
		}
	]
}
