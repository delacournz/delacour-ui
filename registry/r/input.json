			"path": "packages/react-native-ui/src/components/input/input.variants.ts",
			"target": "input/input.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/cn",
					"to": "@registry/lib/cn"
				},
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
