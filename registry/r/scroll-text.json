				{
					"from": "../text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/scroll-text/scroll-text.tsx",
			"target": "scroll-text/scroll-text.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-calm-motion",
					"to": "@registry/hooks/use-calm-motion"
