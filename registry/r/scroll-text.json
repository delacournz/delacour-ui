{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "scroll-text",
	"type": "registry:ui",
	"title": "ScrollText",
	"description": "Text that resolves word by word as the screen scrolls past it.",
	"categories": [
		"media"
	],
	"registryDependencies": [
		"color",
		"screen",
		"text",
		"tv",
		"use-calm-motion",
		"use-theme-color"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [
		"react-native-reanimated"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/react-native-ui/src/components/scroll-text/AGENTS.md",
			"target": "scroll-text/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "@delacour/react-native-ui/scroll-text",
					"to": "@registry/ui/scroll-text"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/scroll-text/index.ts",
			"target": "scroll-text/index.ts",
			"namespace": "ui"
		},
		{
