{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"extends": "//",
	"root": false,
	"files": {
		"includes": ["src/**/*", "!src/uniwind-types.d.ts"]
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"overrides": [
		{
			// Expo Router derives route names from filenames; its conventions
			// (_layout, [id], +not-found) are not kebab-case.
			"includes": ["src/app/**/*"],
			"linter": {
				"rules": {
					"style": { "useFilenamingConvention": "off" }
				}
			}
		}
	]
}
