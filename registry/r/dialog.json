				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/dialog/dialog.context.tsx",
			"target": "dialog/dialog.context.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/react-native-ui/src/components/dialog/dialog.tsx",
			"target": "dialog/dialog.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-controllable-state",
