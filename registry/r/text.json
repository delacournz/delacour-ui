{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "text",
	"type": "registry:ui",
	"title": "Text",
	"description": "Typography: the type scale, weights and the page-level colours.",
	"categories": [
		"display"
	],
	"registryDependencies": [
		"cn",
		"tv"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [
		"react-native-reanimated"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/components/text/AGENTS.md",
			"target": "text/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "@delacour/native-ui/text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/text/index.ts",
			"target": "text/index.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/text/text.context.tsx",
			"target": "text/text.context.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/text/text.tsx",
			"target": "text/text.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/text/text.variants.ts",
			"target": "text/text.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/cn",
					"to": "@registry/lib/cn"
				},
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				}
			]
		}
	]
}
