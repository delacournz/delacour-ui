{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "accordion",
	"type": "registry:ui",
	"title": "Accordion",
	"description": "Collapsible sections whose panels animate to their measured height.",
	"categories": [
		"display"
	],
	"registryDependencies": [
		"icon",
		"icons",
		"pressable",
		"separator",
		"text",
		"tv",
		"use-controllable-state"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [
		"react-native-reanimated"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/components/accordion/accordion-content.tsx",
			"target": "accordion/accordion-content.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/accordion/accordion-description.tsx",
			"target": "accordion/accordion-description.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/accordion/accordion-indicator.tsx",
			"target": "accordion/accordion-indicator.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../icons/central",
					"to": "@registry/icons/central"
				},
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/accordion/accordion-item.tsx",
			"target": "accordion/accordion-item.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/accordion/accordion-title.tsx",
			"target": "accordion/accordion-title.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/accordion/accordion-trigger.tsx",
			"target": "accordion/accordion-trigger.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				},
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/accordion/accordion.context.tsx",
			"target": "accordion/accordion.context.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/accordion/accordion.tsx",
			"target": "accordion/accordion.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-controllable-state",
					"to": "@registry/hooks/use-controllable-state"
				},
				{
					"from": "../separator",
					"to": "@registry/ui/separator"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/accordion/accordion.types.ts",
			"target": "accordion/accordion.types.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/accordion/accordion.variants.ts",
			"target": "accordion/accordion.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				},
				{
					"from": "../icon/icon.variants",
					"to": "@registry/ui/icon/icon.variants"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/accordion/AGENTS.md",
			"target": "accordion/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "delacour-react-native-ui/accordion",
					"to": "@registry/ui/accordion"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/accordion/index.ts",
			"target": "accordion/index.ts",
			"namespace": "ui"
		}
	]
}
