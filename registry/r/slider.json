{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "slider",
	"type": "registry:ui",
	"title": "Slider",
	"description": "A value along a track, dragged by a handle that follows the gesture.",
	"categories": [
		"forms"
	],
	"registryDependencies": [
		"field",
		"pressable",
		"text",
		"tv",
		"use-controllable-state"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [
		"react-native-gesture-handler",
		"react-native-reanimated",
		"react-native-worklets"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/components/slider/AGENTS.md",
			"target": "slider/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "delacour-react-native-ui/slider",
					"to": "@registry/ui/slider"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/slider/index.ts",
			"target": "slider/index.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/slider/slider-fill.tsx",
			"target": "slider/slider-fill.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/slider/slider-output.tsx",
			"target": "slider/slider-output.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/slider/slider-thumb.tsx",
			"target": "slider/slider-thumb.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/slider/slider-track.tsx",
			"target": "slider/slider-track.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/slider/slider.context.tsx",
			"target": "slider/slider.context.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/slider/slider.tsx",
			"target": "slider/slider.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-controllable-state",
					"to": "@registry/hooks/use-controllable-state"
				},
				{
					"from": "../field/field.context",
					"to": "@registry/ui/field/field.context"
				},
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/slider/slider.types.ts",
			"target": "slider/slider.types.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/slider/slider.variants.ts",
			"target": "slider/slider.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				},
				{
					"from": "../text/text.variants",
					"to": "@registry/ui/text/text.variants"
				}
			]
		}
	]
}
