{
	"name": "@delacour/skills",
	"version": "0.1.0",
	"description": "The agent skill the CLI installs and the docs site serves",
	"type": "module",
	"private": true,
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src"
	],
	"scripts": {
		"gen-skill": "bun scripts/gen-components.ts",
		"fmt": "biome format --write ./src",
		"lint": "biome lint --write ./src",
		"check": "biome check ./src ./scripts",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"devDependencies": {
		"@delacour/tsconfig": "workspace:*",
		"@types/bun": "^1.3.8",
		"typescript": "^5.9.3"
	}
}
