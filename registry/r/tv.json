{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "tv",
	"type": "registry:lib",
	"title": "tv",
	"description": "tailwind-variants, taught the library's semantic size tokens.",
	"registryDependencies": [
		"styles"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/lib/tv.ts",
			"target": "tv.ts",
			"namespace": "lib",
			"rewrites": [
				{
					"from": "../styles/tokens",
					"to": "@registry/styles/tokens"
				}
			]
		}
	]
}
