{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "test-mock-maplibre",
	"type": "registry:lib",
	"title": "MapLibre mock",
	"description": "MapLibre's hosts as Views with a stub ref, for the render tests of components that install it.",
	"categories": [
		"testing"
	],
	"registryDependencies": [
		"test-kit"
	],
	"dependencies": [],
	"expoDependencies": [],
	"devDependencies": [
		"@jest/globals"
	],
	"files": [
		{
			"path": "packages/react-native-ui/src/test/mocks/maplibre.ts",
			"target": "test/mocks/maplibre.ts",
			"namespace": "lib",
			"rewrites": [
				{
					"from": "../mock-stub",
					"to": "@registry/lib/test/mock-stub"
				}
			]
		}
	]
}
