{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "switch",
	"type": "registry:ui",
	"title": "Switch",
	"description": "An on/off control whose thumb can be dragged as well as tapped.",
	"categories": [
		"forms"
	],
	"registryDependencies": [
		"field",
		"icon",
		"pressable",
		"text",
		"tv",
		"use-controllable-state",
		"use-theme-color"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [
		"react-native-gesture-handler",
		"react-native-reanimated",
		"react-native-worklets"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/components/switch/AGENTS.md",
			"target": "switch/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "@delacour/native-ui/switch",
					"to": "@registry/ui/switch"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/switch/index.ts",
			"target": "switch/index.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/switch/switch-content.tsx",
			"target": "switch/switch-content.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-theme-color",
					"to": "@registry/hooks/use-theme-color"
				},
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				},
				{
					"from": "../text",
					"to": "@registry/ui/text"
				},
				{
					"from": "../text/text.context",
					"to": "@registry/ui/text/text.context"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/switch/switch-end-content.tsx",
			"target": "switch/switch-end-content.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/switch/switch-start-content.tsx",
			"target": "switch/switch-start-content.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/switch/switch-thumb.tsx",
			"target": "switch/switch-thumb.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-theme-color",
					"to": "@registry/hooks/use-theme-color"
				},
				{
					"from": "../icon",
					"to": "@registry/ui/icon"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/switch/switch.context.tsx",
			"target": "switch/switch.context.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/switch/switch.tsx",
			"target": "switch/switch.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-controllable-state",
					"to": "@registry/hooks/use-controllable-state"
				},
				{
					"from": "../../hooks/use-theme-color",
					"to": "@registry/hooks/use-theme-color"
				},
				{
					"from": "../field/field.context",
					"to": "@registry/ui/field/field.context"
				},
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/switch/switch.types.ts",
			"target": "switch/switch.types.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/switch/switch.variants.ts",
			"target": "switch/switch.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				},
				{
					"from": "../icon/icon.variants",
					"to": "@registry/ui/icon/icon.variants"
				}
			]
		}
	]
}
