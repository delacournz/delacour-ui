		},
		{
			"path": "packages/react-native-ui/src/components/direction/direction.tsx",
			"target": "direction/direction.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/react-native-ui/src/components/direction/direction.variants.ts",
			"target": "direction/direction.variants.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/react-native-ui/src/components/direction/index.ts",
