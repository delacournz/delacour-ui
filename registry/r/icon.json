{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "icon",
	"type": "registry:ui",
	"title": "Icon",
	"description": "A Central Icons glyph that inherits size and colour from the surrounding component.",
	"categories": [
		"display"
	],
	"registryDependencies": [
		"cn",
		"tv",
		"use-theme-color"
	],
	"dependencies": [],
	"expoDependencies": [
		"react-native-svg",
		"uniwind"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/native-ui/src/components/icon/AGENTS.md",
			"target": "icon/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "@delacour/native-ui/icon",
					"to": "@registry/ui/icon"
				},
				{
					"from": "@delacour/native-ui/icons/central",
					"to": "@registry/icons/central"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/icon/icon.context.tsx",
			"target": "icon/icon.context.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/native-ui/src/components/icon/icon.tsx",
			"target": "icon/icon.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-theme-color",
					"to": "@registry/hooks/use-theme-color"
				},
				{
					"from": "@delacour/native-ui/icons/central",
					"to": "@registry/icons/central"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/icon/icon.variants.ts",
			"target": "icon/icon.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/cn",
					"to": "@registry/lib/cn"
				},
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				}
			]
		},
		{
			"path": "packages/native-ui/src/components/icon/index.ts",
			"target": "icon/index.ts",
			"namespace": "ui"
		}
	]
}
