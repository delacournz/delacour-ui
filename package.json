{
	"name": "@delacour/source",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.3.9",
	"scripts": {
		"postinstall": "git rev-parse --git-dir > /dev/null 2>&1 && prek install || true",
		"dev": "turbo dev --ui tui",
		"dev:web": "turbo dev --filter=@delacour/web",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"check": "turbo check",
		"lint": "turbo lint",
		"fmt": "turbo fmt",
		"test": "turbo test",
		"changeset": "changeset",
		"version-packages": "bun .github/changeset-version.ts",
		"release": "changeset publish",
		"verify:expo": "cd packages/cli && bun scripts/verify-expo.ts",
		"nuke": "rm -rf node_modules ./apps/**/node_modules ./packages/**/node_modules && bun install --no-cache -f",
		"previews": "turbo previews --filter=@delacour/playground"
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@legendapp/list": "^3.3.8",
			"@shopify/react-native-skia": "2.6.2",
			"react": "19.2.3",
			"react-dom": "19.2.3",
			"react-native": "0.86.2",
			"react-native-gesture-handler": "~2.32.0",
			"react-native-keyboard-controller": "^1.22.4",
			"react-native-reanimated": "4.5.1",
			"react-native-safe-area-context": "~5.7.0",
			"react-native-screens": "~4.26.0",
			"react-native-svg": "15.15.4",
			"react-native-worklets": "0.10.1"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@delacour/tsconfig": "workspace:*",
		"@j178/prek": "^0.3.5",
		"@types/bun": "^1.3.8",
		"@types/node": "^22.15.0",
		"turbo": "^2.8.2",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"@babel/core": "^7.28.4"
	},
	"trustedDependencies": [
		"@shopify/react-native-skia"
	],
	"patchedDependencies": {
		"expo-modules-jsi@57.0.5": "patches/expo-modules-jsi@57.0.5.patch"
	}
}
