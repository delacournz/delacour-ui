{
	"$schema": "https://raw.githubusercontent.com/delacournz/delacour-ui/main/registry/item.schema.json",
	"name": "rating",
	"type": "registry:ui",
	"title": "Rating",
	"description": "A row of stars that reads or sets a score, by tap or by drag, in whole or half steps.",
	"categories": [
		"forms"
	],
	"registryDependencies": [
		"field",
		"pressable",
		"text",
		"tv",
		"use-controllable-state",
		"use-theme-color"
	],
	"dependencies": [
		"tailwind-variants"
	],
	"expoDependencies": [
		"react-native-gesture-handler",
		"react-native-reanimated",
		"react-native-svg",
		"react-native-worklets"
	],
	"devDependencies": [],
	"files": [
		{
			"path": "packages/react-native-ui/src/components/rating/AGENTS.md",
			"target": "rating/AGENTS.md",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "@delacour/react-native-ui/rating",
					"to": "@registry/ui/rating"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/rating/index.ts",
			"target": "rating/index.ts",
			"namespace": "ui"
		},
		{
			"path": "packages/react-native-ui/src/components/rating/rating-output.tsx",
			"target": "rating/rating-output.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../text",
					"to": "@registry/ui/text"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/rating/rating-star.tsx",
			"target": "rating/rating-star.tsx",
			"namespace": "ui"
		},
		{
			"path": "packages/react-native-ui/src/components/rating/rating-stars.tsx",
			"target": "rating/rating-stars.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-theme-color",
					"to": "@registry/hooks/use-theme-color"
				},
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/rating/rating.context.tsx",
			"target": "rating/rating.context.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/rating/rating.tsx",
			"target": "rating/rating.tsx",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../hooks/use-controllable-state",
					"to": "@registry/hooks/use-controllable-state"
				},
				{
					"from": "../field/field.context",
					"to": "@registry/ui/field/field.context"
				},
				{
					"from": "../pressable",
					"to": "@registry/ui/pressable"
				}
			]
		},
		{
			"path": "packages/react-native-ui/src/components/rating/rating.variants.ts",
			"target": "rating/rating.variants.ts",
			"namespace": "ui",
			"rewrites": [
				{
					"from": "../../lib/tv",
					"to": "@registry/lib/tv"
				},
				{
					"from": "../text/text.variants",
					"to": "@registry/ui/text/text.variants"
				}
			]
		}
	]
}
