{
	"name": "@delacour/brand",
	"version": "1.0.0",
	"description": "The Delacour mark — its master art and the geometry every rendering of it reads",
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./source": "./src/source.ts"
	},
	"files": [
		"assets",
		"src"
	],
	"scripts": {
		"fmt": "biome format --write ./src",
		"lint": "biome lint --write ./src",
		"check": "biome check ./src",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"devDependencies": {
		"@delacour/tsconfig": "workspace:*",
		"@types/bun": "^1.3.8",
		"typescript": "^5.9.3"
	}
}
